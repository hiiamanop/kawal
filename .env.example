# OpenWA live test-account integration. Keep values only in .env, never commit credentials.
KAWAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
KAWAL_OPENWA_BASE_URL=http://127.0.0.1:2785
KAWAL_OPENWA_API_KEY=
KAWAL_OPENWA_SESSION_ID=
KAWAL_OPENWA_ACCOUNT_ID=
KAWAL_OPENWA_TENANT_ID=research
KAWAL_OPENWA_WEBHOOK_SECRET=
KAWAL_OPENWA_TIMEOUT_SECONDS=15
KAWAL_INTAKE_HOST=0.0.0.0
KAWAL_INTAKE_PORT=8001

# OpenRouter is the only remote model provider. Local IndoBERT models stay local.
KAWAL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
KAWAL_OPENROUTER_MODEL=google/gemini-2.5-flash
KAWAL_OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
KAWAL_OPENROUTER_APP_NAME=KAWAL
KAWAL_OPENROUTER_REFERER=https://github.com/hiiamanop/kawal

# Agent Reach CLI (https://github.com/Panniantong/Agent-Reach) for social media.
KAWAL_AGENT_REACH_BIN=
KAWAL_AGENT_REACH_TIMEOUT_SECONDS=60
KAWAL_SOCIAL_CHANNELS=twitter,facebook,instagram
KAWAL_SOCIAL_QUERIES=banjir bandung,jalan rusak bandung,sampah menumpuk bandung
